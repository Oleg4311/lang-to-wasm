{
  "name": "lang-to-wasm",
  "version": "0.1.0",
  "description": "Компилятор маленького языка в WebAssembly без библиотек: свой бинарный кодировщик, оптимизатор, проверка против интерпретатора",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "cli": "node src/cli.ts",
    "site": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "mutate": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1"
  }
}
